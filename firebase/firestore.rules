rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Stub until the `households` module defines membership.
    function isMember(hid) {
      return false;
    }

    // Default deny: no match block grants access yet. Modules add their own.
  }
}
