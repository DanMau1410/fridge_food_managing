# Everything down to "Project rules" is the `flutter create` template (Flutter 3.47.6),
# unchanged, so it can be compared with a fresh one when Flutter is upgraded.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Project rules ---

# `flutter screenshot` output (flutter_01.png, ...)
flutter_*.png

# Desktop platforms are not built in v1: keep their generated plugin registrants out.
**/linux/flutter/generated_plugin_registrant.*
**/linux/flutter/generated_plugins.cmake
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/generated_plugins.cmake

# Per-slice change summary for review (SPEC.md > Collaboration protocol)
.claude/specs/REVIEW.md

# Firebase rules/emulator tooling (firebase/package.json) and the Firebase CLI cache
firebase/node_modules/
.firebase/

# Secrets and key material, anywhere in the repo (dev_rules.md §9)
key.properties
*.jks
*.keystore
*.p12
*.mobileprovision
*.pem
*.key
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
.env
.env.*
!.env.example
.secret.local
.runtimeconfig.json
